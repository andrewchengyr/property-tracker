# Copy to .env and fill in. The real .env is gitignored — never commit it.
# In GitHub Actions these are repository secrets of the same names.

# URA Data Service access key — free registration:
#   https://eservice.ura.gov.sg/maps/api/reg.html
# Required for private residential (condo/landed) transactions.
URA_ACCESS_KEY=

# OneMap account — free registration:
#   https://www.onemap.gov.sg/apidocs/register
# Only required if the watchlist has `hdb` entries (used to geocode
# block + street to lat/lng). URA already supplies coordinates.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
